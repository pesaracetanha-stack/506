{
    "name": "gitiarts/phase2-multitenancy",
    "description": "GitiArts Menu Platform - Phase 2: Multi-Tenancy, Portability, and Persian-First Localization",
    "type": "library",
    "license": "proprietary",
    "version": "5.0.5-test.5",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "GitiArts\\Phase2\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GitiArts\\Phase2\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "migrate:pg": "php scripts/migrate_tenant_to_pg.php",
        "rollback:pg": "php scripts/rollback_pg_to_sqlite.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
